RewriteEngine On

# Clean URL rules
RewriteRule ^office/([a-z0-9-]+)/?$ office.php?slug=$1 [L,QSA]
RewriteRule ^offices/?$ offices.php [L,QSA]
RewriteRule ^map/?$ map.php [L,QSA]
RewriteRule ^events/?$ events.php [L,QSA]
RewriteRule ^event/([a-z0-9-]+)\.ics$ event.php?slug=$1&ics=1 [L,QSA]
RewriteRule ^event/([a-z0-9-]+)/?$ event.php?slug=$1 [L,QSA]
# The finder test page became the home page
RewriteRule ^nearest-beta/?$ / [R=301,L]
RewriteRule ^contracted-institutions/?$ contracted-institutions.php [L,QSA]
RewriteRule ^api/offices/?$ api.php [L,QSA]

# Block direct access to config and private directories
RewriteRule ^(config\.php|includes/|database/|backups/|admin/includes/|scripts/|node_modules/) - [F,L]

# Block hidden files/dirs (.git, .env ...) except .well-known (SSL validation)
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Block source/data files that are not meant to be served
RewriteRule \.(sql|md|py|json|log|bak|sh)$ - [F,L,NC]

# Custom 404 error document
ErrorDocument 404 /404.php

# Security headers
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"

# Prevent directory listing
Options -Indexes

# Fonts served with the right type (self-hosted icon font)
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>

# Compress text responses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Browser caching: images and fonts rarely change; CSS/JS links carry ?v= versions where it matters
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
